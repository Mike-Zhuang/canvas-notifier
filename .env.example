# 复制到 .env；所有凭据只写入 secrets/ 下的权限 600 文件
DATABASE_URL=sqlite+aiosqlite:///.local/canvas.db
CANVAS_BASE_URL=https://canvas.tongji.edu.cn
CANVAS_TOKEN_FILE=secrets/canvas-token
CANVAS_COOKIE_FILE=secrets/canvas-cookies.json
CANVAS_AUTH_MODE=token
CANVAS_COOKIE_FALLBACK=false
# 等价性验证通过后填写允许 Cookie fallback 的资源名，以逗号分隔
CANVAS_COOKIE_RESOURCES=
PUBLIC_BASE_URL=http://127.0.0.1:8000
ADMIN_PASSWORD_FILE=secrets/admin-password
SESSION_SECRET_FILE=secrets/session-key
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD_FILE=secrets/smtp-password
MAIL_FROM=canvas@localhost.test
MAIL_TO=
MAIL_TEST_TO=
DISPLAY_TIMEZONE=Asia/Shanghai

# IAM 自动恢复须显式启用，仅在 Token、Cookie 均明确失效时运行
IAM_AUTO_LOGIN=false
IAM_USERNAME_FILE=secrets/iam-username
IAM_PASSWORD_FILE=secrets/iam-password
IAM_COOKIE_FILE=secrets/iam-cookies.json
IAM_TIMEOUT_SECONDS=90
IAM_RETRY_SECONDS=900
