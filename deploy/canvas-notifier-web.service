[Unit]
Description=Canvas Notifier Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canvas-notifier
Group=canvas-notifier
WorkingDirectory=/opt/canvas-notifier/current
EnvironmentFile=/etc/canvas-notifier/service.env
ExecStart=/opt/canvas-notifier/current/.venv/bin/canvas-notifier web --host 127.0.0.1 --port 18400
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/canvas-notifier /etc/canvas-notifier/secrets
MemoryMax=220M
TasksMax=64

[Install]
WantedBy=multi-user.target
