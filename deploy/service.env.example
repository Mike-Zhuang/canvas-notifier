DATABASE_URL=sqlite+aiosqlite:////var/lib/canvas-notifier/state.db
BACKUP_DIRECTORY=/var/lib/canvas-notifier/backups
PUBLIC_BASE_URL=https://canvas.example.org
CANVAS_BASE_URL=https://canvas.tongji.edu.cn
CANVAS_AUTH_MODE=token
CANVAS_TOKEN_FILE=/etc/canvas-notifier/secrets/canvas-token
CANVAS_COOKIE_FILE=/etc/canvas-notifier/secrets/canvas-cookies.json
CANVAS_COOKIE_FALLBACK=true
CANVAS_COOKIE_RESOURCES=identity,course,assignment,submission,announcement,file,folder,discussion,reply,module,module_item,page,conversation,calendar,planner,planner_note
IAM_AUTO_LOGIN=true
IAM_USERNAME_FILE=/etc/canvas-notifier/secrets/iam-username
IAM_PASSWORD_FILE=/etc/canvas-notifier/secrets/iam-password
IAM_COOKIE_FILE=/etc/canvas-notifier/secrets/iam-cookies.json
ADMIN_PASSWORD_FILE=/etc/canvas-notifier/secrets/admin-password
SESSION_SECRET_FILE=/etc/canvas-notifier/secrets/session-key
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=notifications@example.org
SMTP_PASSWORD_FILE=/etc/canvas-notifier/secrets/smtp-password
MAIL_FROM=notifications@example.org
MAIL_TO=student@example.org
MAIL_TEST_TO=student@example.org
